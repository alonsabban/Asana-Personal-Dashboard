# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# launcher log — written by START-DASHBOARD.bat on each run
/dashboard-log.txt

# personal scratch — kept locally, not part of the app
/New folder/
/.claude/
/AGENTS.md
/CLAUDE.md

# screenshots used for docs/experiments, not needed at runtime
/feed.png
/tut.png
/tut2.png
/public/feed.png
/public/tut.png
/public/tut2.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
